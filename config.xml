<?xml version='1.0' encoding='utf-8'?>
<widget id="com.indomoney.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Indo Money</name>
    <description>Indo Money - Game Coin Hub Deposit</description>
    <author email="harshitrathi1@gmail.com" href="https://github.com/harshitrathi1">Harshit Rathi</author>
    
    <content src="index.html" />
    
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <platform name="android">
        <allow-intent href="market:*" />
        <icon src="res/icons/android/drawable-ldpi-icon.png" density="ldpi" />
        <icon src="res/icons/android/drawable-mdpi-icon.png" density="mdpi" />
        <icon src="res/icons/android/drawable-hdpi-icon.png" density="hdpi" />
        <icon src="res/icons/android/drawable-xhdpi-icon.png" density="xhdpi" />
        <icon src="res/icons/android/drawable-xxhdpi-icon.png" density="xxhdpi" />
        <icon src="res/icons/android/drawable-xxxhdpi-icon.png" density="xxxhdpi" />
        <splash src="res/screens/android/splash-land-ldpi.png" density="land-ldpi" />
        <splash src="res/screens/android/splash-land-mdpi.png" density="land-mdpi" />
        <splash src="res/screens/android/splash-land-hdpi.png" density="land-hdpi" />
        <splash src="res/screens/android/splash-land-xhdpi.png" density="land-xhdpi" />
        <splash src="res/screens/android/splash-port-ldpi.png" density="port-ldpi" />
        <splash src="res/screens/android/splash-port-mdpi.png" density="port-mdpi" />
        <splash src="res/screens/android/splash-port-hdpi.png" density="port-hdpi" />
        <splash src="res/screens/android/splash-port-xhdpi.png" density="port-xhdpi" />
    </platform>
    
    <engine name="android" spec="^11.0.0" />
    <plugin name="cordova-plugin-whitelist" spec="^1.3.3" />
    <plugin name="cordova-plugin-statusbar" spec="^2.4.2" />
    <plugin name="cordova-plugin-device" spec="^2.0.2" />
    <plugin name="cordova-plugin-splashscreen" spec="^5.0.2" />
</widget>
